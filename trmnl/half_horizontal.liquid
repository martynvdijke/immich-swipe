<div class="columns">
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Kept</span>
        <span class="value value--large">{{ IDX_0.keptCount }}</span>
      </div>
    </div>
    <div class="col col--start gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">Deleted</span>
          <span class="value value--large">{{ IDX_0.deletedCount }}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Total</span>
        <span class="value value--medium">{{ IDX_0.totalCount }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Kept {{ IDX_0.keptCount }} · Deleted {{ IDX_0.deletedCount }}</span>
      </div>
    </div>
    {% if IDX_0.users.size > 1 %}
      {% for user in IDX_0.users %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ user.userName }}: {{ user.keptCount }} / {{ user.deletedCount }}</span>
        </div>
      </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Immich Swipe Stats</span>
</div>
