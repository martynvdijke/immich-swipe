# Immich Swipe - Server Configuration
# These are read at RUNTIME by the Go backend (no rebuild needed)

# Your Immich server URL (default for login; required for env-configured users)
IMMICH_SERVER_URL=http://immich.home:2283

# Env API keys are OPTIONAL: they pre-provision local Swipe accounts and their
# Immich API keys at startup. They are NOT a login path (there is no auto-login
# and no env-user picker); each account signs in with its own user name/password.

# User 1 (optional - pre-provisioned Swipe account)
IMMICH_API_KEY_1_NAME=Alice
IMMICH_API_KEY_1_KEY=your-api-key-here

# User 2 (optional)
IMMICH_API_KEY_2_NAME=Bob
IMMICH_API_KEY_2_KEY=another-api-key-here

# Add more users as needed (IMMICH_API_KEY_3_NAME, IMMICH_API_KEY_3_KEY, etc.)
# Env users are migrated into local Swipe accounts at startup; they are NOT a
# separate login path. The login UI offers:
#   - Sign in / Create account (local Swipe account: user name + password)
#   - SSO button (shown automatically when Immich has OAuth enabled; the
#     IdP must allow the redirect URI <swipe-host>/api/auth/oauth/callback)
#
# Every account uses the server URL below unless it sets its own. An account
# without an Immich API key is sent to Settings to add one.

# ---- SSO callback base URL (optional) ---------------------------------------
# External base URL of this instance, used as the OAuth redirect_uri.
# Leave empty to derive it from each request (honors X-Forwarded-Proto/Host).
# Set it explicitly when running behind a reverse proxy that doesn't forward
# the external host/scheme correctly.
# SWIPE_PUBLIC_URL=https://swipe.example.com

# ---- Local Swipe accounts (optional) ----------------------------------------
# Any person can set a password for their own account once logged in:
# Settings → Account password. The password is stored PBKDF2-hashed in the
# sessions database (IMMICH_SESSIONS_DB) and is never sent to Immich.
# Env-configured users are migrated into local accounts automatically at
# startup (existing API keys keep working); once a password is set, that
# account can only log in with the password.

# ---- Trmnl e-ink stats persistence (optional) ------------------------------
# If set, the keep/delete counters served at /api/trmnl/stats are saved to
# this JSON file after every counted action and restored on restart.
# Leave empty for in-memory only (counters reset on restart).
# TRMNL_STATS_FILE=/data/trmnl-stats.json

# ---- Session persistence (optional) ----------------------------------------
# If set, Swipe sessions (token + Immich API key / access token) are stored in
# a SQLite database so all logged-in users stay logged in across server
# restarts. Leave empty for in-memory only (sessions are lost on restart and
# everyone must log in again).
#
# NOTE: This file contains Immich credentials in plain text (API keys /
# access tokens). Treat it like a secrets file: keep it inside the container
# volume, restrict permissions, and never commit it to version control.
# IMMICH_SESSIONS_DB=/data/immich-swipe.db

# ---- OpenTelemetry (server-side, optional) -------------------------------
# These configure telemetry for the Go BACKEND (HTTP middleware + proxy),
# using the standard OTel SDK env vars. They are SEPARATE from the
# browser-side Umami/OTel settings, which are configured in the app UI
# under Settings (gear icon) and persisted in localStorage per server/user.
# See the standard OTel SDK environment variable docs for all options.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example.com:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc        # grpc | http/protobuf
# OTEL_SERVICE_NAME=immich-swipe-server
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# ---- Email / SMTP (optional) ------------------------------------------------
# Used for password reset emails and admin test emails.
# When SMTP_HOST is set via env, it overrides DB settings (Settings UI will show from_env).
# SMTP_TLS: starttls (default), ssl (implicit TLS on 465), or none.
# SWIPE_PUBLIC_URL is also used to build the password reset link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@example.com
# SMTP_TLS=starttls
# SWIPE_PUBLIC_URL=https://swipe.example.com

# ---- Legal / privacy pages (optional, recommended) -------------------------
# These values are published on the public /privacy, /terms and /account/delete
# pages (GET /api/legal). No configuration works, but an instance that stores
# real data should name its operator. Env-only: restart to apply.
#
# LEGAL_CONTROLLER_NAME is the GDPR "controller". Empty falls back to
# "the operator of this Immich Swipe instance".
# LEGAL_CONTACT_EMAIL adds a mailto: contact and the email fallback on the
# deletion page. Empty removes both rather than inventing an address.
# LEGAL_CONTACT_ADDRESS is optional (good practice for EU operators).
# LEGAL_HOSTING_REGION describes where the server runs (default "the European Union").
# LEGAL_CONTROLLER_NAME="Example Photo Cooperative"
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_CONTACT_ADDRESS="1 Example Street, 1000 AA Amsterdam"
# LEGAL_HOSTING_REGION="the Netherlands"

# ---- Public demo account for app-store review (optional) -------------------
# Set DEMO_USER_ENABLED=true to expose a read/write demo login on the public
# login page and via GET /api/auth/config. This is intended for Google Play /
# App Store reviewers; it is OFF by default.
#
# SECURITY: when enabled, DEMO_USER_NAME and DEMO_USER_PASSWORD are returned in
# plain text by GET /api/auth/config, so anyone who can reach the instance can
# sign in with them. Use a dedicated Immich user whose API key you are willing
# to expose to demo traffic, never a personal or admin key. DEMO_USER_API_KEY is
# required when enabled; the demo user cannot log in without it.
#
# DEMO_USER_ENABLED=false
# DEMO_USER_NAME=demo
# DEMO_USER_PASSWORD=demo
# DEMO_USER_API_KEY=your-dedicated-demo-immich-api-key
# DEMO_USER_SERVER_URL=http://immich.home:2283   # default: IMMICH_SERVER_URL
# DEMO_USER_EMAIL=demo@example.com               # optional; shown to the reviewer
