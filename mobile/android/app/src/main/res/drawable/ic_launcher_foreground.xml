<?xml version="1.0" encoding="utf-8"?>
<!-- Immich Swipe mark for the adaptive icon (108x108 viewport, transparent).
     The photo frame is 47dp wide, so the whole mark (frame + swipe arrow)
     stays inside the 66x66dp safe zone of the 108dp layer: see the corner
     check in the build notes - max radius 32.73dp < 33dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- photo card -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M34.42,28.95 H73.58 A3.92,3.92 0 0 1 77.5,32.87 V64.2 A3.92,3.92 0 0 1 73.58,68.12 H34.42 A3.92,3.92 0 0 1 30.5,64.2 V32.87 A3.92,3.92 0 0 1 34.42,28.95 Z" />

    <!-- lavender ridge -->
    <path
        android:fillColor="#FFC4B5FD"
        android:pathData="M30.5 60.28 L42.25 48.53 L54 56.37 L65.75 40.7 L77.5 60.28 L77.5 64.2 L30.5 64.2 Z" />

    <!-- sun -->
    <path
        android:fillColor="#FFFDE68A"
        android:pathData="M59.48,39.13 a6.27,6.27 0 1,0 12.53,0 a6.27,6.27 0 1,0 -12.53,0 Z" />

    <!-- swipe arrow (right = keep) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.52"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M46.01 77.83 L61.52 77.83 M52.59 72.19 L61.52 77.83 L52.59 83.47" />
</vector>
