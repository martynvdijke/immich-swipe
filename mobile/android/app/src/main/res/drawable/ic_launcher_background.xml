<?xml version="1.0" encoding="utf-8"?>
<!-- Favicon gradient. The SVG runs #4f46e5 (top-left) to #7c3aed
     (bottom-right), i.e. CSS 135deg. Android measures the angle
     counter-clockwise from "left to right", so that same direction is 315.
     Full-bleed on purpose: the launcher applies the adaptive-icon mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF4F46E5"
        android:endColor="#FF7C3AED" />
</shape>
